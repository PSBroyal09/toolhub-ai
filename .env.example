# 참고용 루트 환경변수 목록. 실제 값은 apps/api/.env, apps/web/.env.local 에 각각 설정합니다.

# apps/api
DATABASE_URL="postgresql://toolhub:toolhub@localhost:5432/toolhub"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# apps/web
NEXT_PUBLIC_API_URL="http://localhost:3001"
